# --- MySQL ---
DB_NAME=wp
DB_USER=wp
DB_PASSWORD=change_me      # set a strong password in real .env
DB_ROOT_PASSWORD=change_me # strong root password

# --- WordPress ---
WP_ENV=development         # development | production
WP_DEBUG=true              # true in dev, false in prod
WP_REDIS_HOST=redis        # if using Redis service

# --- Optional SMTP (prod) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=change_me
# SMTP_SECURE=tls